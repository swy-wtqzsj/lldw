<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.salmon.pet.mapper.RevisitMapper">

    <resultMap id="RevisitResultMap" type="com.salmon.pet.entity.Revisit">
        <id property="revisitId" column="revisit_id"/>
        <result property="adoptId" column="adopt_id"/>
        <result property="revisitDate" column="revisit_date"/>
        <result property="photo" column="photo"/>
        <result property="healthDesc" column="health_desc"/>
        <result property="status" column="status"/>
        <result property="adminRemark" column="admin_remark"/>
        <result property="petName" column="pet_name"/>
        <result property="username" column="username"/>
    </resultMap>

    <insert id="insert" parameterType="com.salmon.pet.entity.Revisit" useGeneratedKeys="true" keyProperty="revisitId">
        INSERT INTO revisit (adopt_id, revisit_date, photo, health_desc, status)
        VALUES (#{adoptId}, NOW(), #{photo}, #{healthDesc}, 1)
    </insert>

    <select id="selectAdminList" resultMap="RevisitResultMap">
        SELECT r.*, p.pet_name, u.username
        FROM revisit r
        LEFT JOIN adoption a ON r.adopt_id = a.adopt_id
        LEFT JOIN pet p ON a.pet_id = p.pet_id
        LEFT JOIN user u ON a.user_id = u.user_id
        <where>
            <if test="status != null">
                AND r.status = #{status}
            </if>
        </where>
        ORDER BY r.revisit_date DESC
    </select>

    <select id="selectById" resultMap="RevisitResultMap">
        SELECT * FROM revisit WHERE revisit_id = #{revisitId}
    </select>

    <update id="updateStatus">
        UPDATE revisit SET status = #{status}, admin_remark = #{adminRemark}
        WHERE revisit_id = #{revisitId}
    </update>

    <select id="selectByAdoptId" resultMap="RevisitResultMap">
        SELECT * FROM revisit WHERE adopt_id = #{adoptId} ORDER BY revisit_date DESC
    </select>

</mapper>
